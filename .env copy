# ==============================================================================
# CONFIGURATION GÉNÉRALE DE L'APPLICATION
# ==============================================================================
APP_ENV=development
APP_NAME=DataPipeline
LOG_LEVEL=INFO

# ==============================================================================
# 1. BASE DE DONNÉES SOURCE #1 (ex: Application / CRM)
# ==============================================================================
SRC_crm_TYPE=postgresql
SRC_crm_HOST=host
SRC_crm_PORT=5432
SRC_crm_NAME=crm
SRC_crm_USER=postgres
SRC_crm_PASSWORD=password
SRC_crm_SCHEMA=oltp


# ==============================================================================
# 2. BASE DE DONNÉES SOURCE #2 (ex: ERP / Système Externe)
# ==============================================================================
SRC_erp_TYPE=postgresql
SRC_erp_HOST=host
SRC_erp_PORT=5432
SRC_erp_NAME=erp
SRC_erp_USER=postgres
SRC_erp_PASSWORD=password
SRC_erp_SCHEMA=oltp

# ==============================================================================
# 3. DATA WAREHOUSE (DWH)
# ==============================================================================
DWH_TYPE=postgresql
DWH_HOST=host
DWH_PORT=5432
DWH_NAME=datawarehouse_entreprise
DWH_USER=postgres
DWH_PASSWORD=password

# Schémas pour la modélisation Medallion
DWH_SCHEMA_BRONZE=bronze
DWH_SCHEMA_SILVER=silver
DWH_SCHEMA_GOLD=gold

# ==============================================================================
# PARAMÈTRES PIPELINE / ETL / ELT
# ==============================================================================
BATCH_SIZE=10000
MAX_RETRIES=3